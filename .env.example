# Interlock configuration.
#
# Copy to .env and edit. Every value here has a working default -- the system runs with
# NO API KEY AT ALL against a local Ollama, which is the point: a judge clones the repo
# and runs one command.
#
# NEVER commit .env, an API key, or a tenant canary string (CLAUDE.md §9).

# --- upstream providers ----------------------------------------------------
# Ollama is the default and needs no key. Two local models give a real two-tier router.
INTERLOCK_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
INTERLOCK_CHEAP_PROVIDER=ollama
INTERLOCK_CHEAP_MODEL=qwen3:4b
INTERLOCK_STRONG_PROVIDER=ollama
INTERLOCK_STRONG_MODEL=qwen3:8b

# Set these only if you want to route to a hosted provider instead.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- services --------------------------------------------------------------
INTERLOCK_OBSERVER_URL=http://127.0.0.1:8081

# --- budgets ---------------------------------------------------------------
# Lane A's hard deadline. A detector that misses it is dropped, not awaited.
INTERLOCK_LANE_A_DEADLINE_MS=40
# What the observer gets per sentence; the caller's timeout adds a 30 ms margin.
INTERLOCK_OBSERVE_DEADLINE_MS=120
# If the model stalls mid-sentence, flush the buffer rather than hang the stream.
INTERLOCK_SENTENCE_WATCHDOG_S=8

# --- storage and policy ----------------------------------------------------
INTERLOCK_DB_PATH=./data/interlock.db
INTERLOCK_POLICY_PATH=./policies/banking.yaml
INTERLOCK_TENANT_ID=demo

# --- privacy ---------------------------------------------------------------
# Prompts are stored HASHED unless this is 1. Turn it on for the demo only.
INTERLOCK_STORE_PROMPTS=0
